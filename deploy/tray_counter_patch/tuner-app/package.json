{
  "name": "tray-counter-tuner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test:engine": "node --experimental-strip-types scripts/check-engine.ts",
    "build:standalone-engine": "esbuild src/engine.ts --bundle --format=iife --global-name=TrayEngine --target=es2020 --outfile=dist-standalone/engine.js",
    "dev:server": "PORT=5181 node server/server.mjs",
    "start": "node server/server.mjs",
    "export": "node --experimental-strip-types scripts/export_runs.ts"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.3",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "^0.25.4",
    "typescript": "5.8.3",
    "vite": "6.4.4"
  }
}
